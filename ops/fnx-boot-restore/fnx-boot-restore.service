[Unit]
Description=Restore the previously active Flash Next container after host boot
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /root/ascend-dev/fnx-boot-restore/boot_restore.sh
RemainAfterExit=yes
TimeoutStartSec=1000

[Install]
WantedBy=multi-user.target
